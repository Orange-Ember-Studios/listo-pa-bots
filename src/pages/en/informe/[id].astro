---
export const prerender = false;

import ReportPage from '../../../components/ReportPage.astro';
import { getReportById, getDomainHistory } from '../../../lib/reports.js';
import { scoreScan } from '../../../scoring/index.js';

const id = Astro.params.id;
if (!id) {
  return new Response('Report not found', { status: 404 });
}

const snapshot = await getReportById(id, Astro.url.origin);
if (!snapshot) {
  return new Response('Report not found', { status: 404 });
}

const result = scoreScan(snapshot);

let domain = '';
try {
  domain = new URL(snapshot.url).hostname.replace(/^www\./, '');
} catch {
  domain = '';
}

const history = domain ? await getDomainHistory(domain, Astro.url.origin, 12) : [];
---

<ReportPage locale="en" id={id} snapshot={snapshot} result={result} history={history} />
