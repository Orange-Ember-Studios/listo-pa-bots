---
import '../styles/tokens.css';
import ThemeInit from '../components/ThemeInit.astro';
import Wordmark from '../components/Wordmark.astro';
import ThemeToggle from '../components/ThemeToggle.astro';

const title = 'Listo Pa Bots — Escanea si tu sitio está listo para agentes de IA';
const description =
  'Escaneo gratuito de agentic-readiness para dueños de negocio. Descubre si los agentes de IA pueden ver, encontrar y operar tu sitio web.';
const ogImage = 'https://listopabots.orangeember.com/og-image.png';
const canonical = 'https://listopabots.orangeember.com/';

const featureChecks = [
  {
    id: 'robots-txt',
    name: 'robots.txt segmentado',
    body: 'Permite o bloquea secciones específicas para agentes de IA sin afectar tu SEO general.',
    icon: ['M4 4h16v16H4z', 'M9 9h6v6H9z', 'M6 9h1', 'M6 12h1', 'M6 15h1', 'M17 9h1', 'M17 12h1', 'M17 15h1'],
  },
  {
    id: 'rendering',
    name: 'SSR / contenido estático',
    body: 'Los bots leen tu contenido sin ejecutar JavaScript, ideal para velocidad y indexación.',
    icon: ['M13 2L3 14h9l-1 8 10-12h-9l1-8z'],
  },
  {
    id: 'llms-txt',
    name: 'llms.txt',
    body: 'Un archivo pensado para modelos de lenguaje: resumen de tu negocio, reglas y enlaces clave.',
    icon: ['M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z', 'M14 2v6h6', 'M16 13H8', 'M16 17H8', 'M10 9H8'],
  },
  {
    id: 'sitemap',
    name: 'sitemap.xml',
    body: 'Mapa completo y actualizado para que los agentes descubran todas tus páginas relevantes.',
    icon: ['M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5'],
  },
  {
    id: 'headers',
    name: 'headers HTTP',
    body: 'Cabeceras de seguridad y caché que mejoran rendimiento y confianza de los rastreadores.',
    icon: ['M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z'],
  },
];
---

<html lang="es">
  <head>
    <ThemeInit />
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="es_CO" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <Wordmark />
        <ThemeToggle />
      </div>
    </header>

    <main class="container">
      <section class="hero" aria-labelledby="hero-title">
        <p class="eyebrow">Visibilidad pa bots</p>
        <h1 id="hero-title" class="hero-title">
          ¿Tu sitio está listo<br />para los agentes de IA?
        </h1>
        <p class="lead">
          Escaneo gratuito en segundos. Te decimos si los bots de inteligencia artificial pueden ver,
          encontrar y operar tu negocio online.
        </p>

        <div class="scan-card" id="scan-card">
          <form id="scan-form" class="scan-form" novalidate>
            <label class="sr-only" for="url">URL de tu sitio</label>
            <div class="input-row">
              <input
                id="url"
                name="url"
                type="text"
                inputmode="url"
                autocomplete="url"
                placeholder="https://tunegocio.com"
                required
              />
              <button type="submit" class="btn btn-primary" id="submit-btn">
                <span class="btn-text">Escanear</span>
                <span class="spinner" aria-hidden="true"></span>
              </button>
            </div>
          </form>

          <div id="state" class="state state-loading" style="display: none;">
            <div class="state-glow" aria-hidden="true"></div>
            <p><strong>Revisando tu sitio...</strong></p>
            <ul>
              <li>Verificamos robots.txt y acceso para agentes</li>
              <li>Buscamos llms.txt y sitemap.xml</li>
              <li>Medimos velocidad de carga y renderizado</li>
            </ul>
          </div>

          <div id="error" class="state state-error" style="display: none;"></div>

          <div id="result" class="result" style="display: none;">
            <div class="result-score">
              <span id="score-value">0</span><span class="result-max">/ 100</span>
            </div>
            <div class="result-label" id="score-label">Listo Pa Bots</div>
            <p class="result-url" id="result-url"></p>

            <div class="breakdown" id="breakdown" aria-label="Desglose por check"></div>

            <div class="actions">
              <a id="report-link" href="#" class="btn btn-primary">Ver el informe completo</a>
              <button id="copy-link" class="btn btn-secondary" type="button">Copiar enlace</button>
            </div>
          </div>
        </div>
      </section>

      <section class="features" aria-labelledby="features-title">
        <h2 id="features-title" class="section-title">¿Qué revisamos?</h2>
        <div class="features-grid">
          {
            featureChecks.map((check) => (
              <article class="feature-card">
                <div class="feature-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                    {check.icon.map((d) => (
                      <path d={d} />
                    ))}
                  </svg>
                </div>
                <h3>{check.name}</h3>
                <p>{check.body}</p>
              </article>
            ))
          }
        </div>
      </section>

      <footer class="site-footer">
        <p>
          Hecho por <a href="https://orangeember.com">Orange Ember Studios</a> ·
          <a href="https://github.com/Orange-Ember-Studios/listo-pa-bots">Código abierto</a>
        </p>
      </footer>
    </main>

    <style>
      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
      }

      .container {
        width: 100%;
        max-width: 760px;
        margin: 0 auto;
        padding: 0 var(--space-md);
      }

      .site-header {
        padding: var(--space-md) 0;
      }

      .header-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-md);
      }

      .hero {
        padding: var(--space-xl) 0 var(--space-2xl);
        text-align: center;
      }

      .eyebrow {
        display: inline-block;
        margin: 0 0 var(--space-sm);
        font-size: 0.8125rem;
        font-weight: 700;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--accent-secondary);
        text-shadow: 0 0 24px var(--accent-secondary-glow);
      }

      .hero-title {
        font-size: clamp(2.5rem, 10vw, 4.25rem);
        font-weight: 800;
        line-height: 1.05;
        letter-spacing: -0.03em;
        margin: 0 0 var(--space-md);
        text-wrap: balance;
      }

      .hero-title::after {
        content: '';
        display: block;
        width: 80px;
        height: 4px;
        margin: var(--space-md) auto 0;
        border-radius: var(--radius-pill);
        background: var(--accent-gradient);
        box-shadow: 0 0 24px var(--accent-glow);
      }

      .lead {
        font-size: clamp(1.125rem, 4vw, 1.375rem);
        font-weight: 300;
        line-height: 1.55;
        color: var(--text-muted);
        margin: 0 auto var(--space-xl);
        max-width: 560px;
      }

      .scan-card {
        background: var(--bg-elevated);
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        padding: var(--space-md);
        box-shadow: var(--shadow);
      }

      @media (min-width: 640px) {
        .scan-card {
          padding: var(--space-lg);
        }
      }

      .scan-form {
        width: 100%;
      }

      .input-row {
        display: flex;
        flex-direction: column;
        gap: var(--space-sm);
      }

      @media (min-width: 520px) {
        .input-row {
          flex-direction: row;
          align-items: stretch;
        }
      }

      .input-row input {
        flex: 1 1 auto;
        min-width: 0;
        font-size: 1rem;
        padding: var(--space-sm) var(--space-md);
        border: 1px solid var(--border);
        border-radius: var(--radius-pill);
        background: var(--bg);
        color: var(--text);
        outline: none;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
        min-height: 3rem;
      }

      .input-row input::placeholder {
        color: var(--text-muted);
        opacity: 1;
      }

      .input-row input:focus {
        border-color: var(--accent-1);
        box-shadow: 0 0 0 3px var(--accent-glow);
      }

      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: var(--space-xs);
        font-size: 1rem;
        font-weight: 700;
        padding: var(--space-sm) var(--space-md);
        border-radius: var(--radius-pill);
        border: 1px solid transparent;
        min-height: 3rem;
        text-decoration: none;
        cursor: pointer;
        transition: transform 0.15s ease, box-shadow 0.2s ease, border-color 0.2s ease;
      }

      .btn:hover:not(:disabled) {
        transform: translateY(-1px);
      }

      .btn-primary {
        background: var(--accent-gradient);
        color: #fff;
        border-color: transparent;
        box-shadow: 0 8px 28px var(--accent-glow);
      }

      .btn-primary:hover:not(:disabled) {
        box-shadow: 0 12px 36px var(--accent-glow), 0 0 0 1px rgba(255, 255, 255, 0.1) inset;
      }

      .btn-secondary {
        background: transparent;
        color: var(--text);
        border-color: var(--border);
      }

      .btn-secondary:hover:not(:disabled) {
        border-color: var(--accent-1);
        color: var(--accent-1);
      }

      .btn:disabled {
        opacity: 0.8;
        cursor: wait;
      }

      .btn .spinner {
        display: none;
      }

      .btn[aria-busy='true'] .btn-text {
        display: none;
      }

      .btn[aria-busy='true'] .spinner {
        display: inline-block;
      }

      .spinner {
        width: 1.25rem;
        height: 1.25rem;
        border: 3px solid rgba(255, 255, 255, 0.35);
        border-top-color: #ffffff;
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
      }

      @keyframes spin {
        to {
          transform: rotate(360deg);
        }
      }

      .state {
        margin-top: var(--space-md);
        padding: var(--space-md);
        border-radius: var(--radius-md);
        font-size: 0.9375rem;
      }

      .state p {
        margin: 0 0 var(--space-xs);
      }

      .state ul {
        margin: 0;
        padding-left: 1.25rem;
      }

      .state li {
        margin-bottom: 0.35rem;
      }

      .state-loading {
        position: relative;
        overflow: hidden;
        background: var(--bg);
        border: 1px solid var(--border);
        color: var(--text-muted);
      }

      .state-loading strong {
        color: var(--text);
      }

      .state-glow {
        position: absolute;
        inset: 0;
        pointer-events: none;
        background: radial-gradient(circle at 50% 50%, var(--accent-glow), transparent 70%);
        animation: pulse-glow 2s ease-in-out infinite;
      }

      @keyframes pulse-glow {
        0%, 100% {
          opacity: 0.5;
          transform: scale(0.96);
        }
        50% {
          opacity: 1;
          transform: scale(1.04);
        }
      }

      .state-error {
        background: var(--state-fallo-bg);
        border: 1px solid var(--state-fallo);
        color: var(--state-fallo);
      }

      .result {
        margin-top: var(--space-lg);
        text-align: center;
      }

      .result-score {
        font-size: clamp(3.5rem, 14vw, 5.5rem);
        font-weight: 800;
        line-height: 1;
        letter-spacing: -0.04em;
      }

      .result-max {
        font-size: 1.5rem;
        font-weight: 600;
        color: var(--text-muted);
        margin-left: 0.1em;
      }

      .result-label {
        display: inline-block;
        margin-top: var(--space-sm);
        padding: var(--space-xs) var(--space-md);
        border-radius: var(--radius-pill);
        font-size: 1.125rem;
        font-weight: 700;
      }

      .result-label.state-ok {
        background: var(--state-ok-bg);
        color: var(--state-ok);
      }

      .result-label.state-parcial {
        background: var(--state-parcial-bg);
        color: var(--state-parcial);
      }

      .result-label.state-fallo {
        background: var(--state-fallo-bg);
        color: var(--state-fallo);
      }

      .result-url {
        margin: var(--space-sm) 0 0;
        color: var(--text-muted);
        font-size: 0.9375rem;
        word-break: break-all;
      }

      .breakdown {
        margin-top: var(--space-lg);
        display: grid;
        gap: var(--space-md);
      }

      .breakdown-item {
        text-align: left;
      }

      .breakdown-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-sm);
        margin-bottom: var(--space-xs);
        font-size: 0.9375rem;
      }

      .breakdown-name {
        font-weight: 600;
      }

      .breakdown-score {
        font-weight: 700;
        color: var(--text-muted);
        white-space: nowrap;
      }

      .bar-track {
        height: 8px;
        border-radius: var(--radius-pill);
        background: var(--bar-track-bg);
        border: 1px solid var(--border);
        overflow: hidden;
      }

      .bar-fill {
        height: 100%;
        border-radius: var(--radius-pill);
        width: 0;
        transition: width 0.8s cubic-bezier(0.22, 1, 0.36, 1);
      }

      .bar-fill.state-ok {
        background: var(--state-ok);
        box-shadow: 0 0 12px rgba(52, 211, 153, 0.35);
      }

      .bar-fill.state-parcial {
        background: var(--state-parcial);
        box-shadow: 0 0 12px rgba(245, 166, 35, 0.35);
      }

      .bar-fill.state-fallo {
        background: var(--state-fallo);
        box-shadow: 0 0 12px rgba(248, 113, 113, 0.35);
      }

      .actions {
        margin-top: var(--space-lg);
        display: flex;
        flex-direction: column;
        gap: var(--space-sm);
      }

      @media (min-width: 520px) {
        .actions {
          flex-direction: row;
          justify-content: center;
        }
      }

      .features {
        padding-bottom: var(--space-2xl);
      }

      .section-title {
        text-align: center;
        font-size: 1.75rem;
        font-weight: 700;
        margin: 0 0 var(--space-lg);
      }

      .features-grid {
        display: grid;
        gap: var(--space-md);
      }

      @media (min-width: 560px) {
        .features-grid {
          grid-template-columns: repeat(2, 1fr);
        }
      }

      .feature-card {
        background: var(--bg-elevated);
        border: 1px solid var(--border);
        border-radius: var(--radius-md);
        padding: var(--space-md);
        transition: transform 0.2s ease, border-color 0.2s ease;
      }

      .feature-card:hover {
        transform: translateY(-2px);
        border-color: var(--accent-1);
      }

      .feature-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2.75rem;
        height: 2.75rem;
        border-radius: var(--radius-pill);
        background: var(--bg);
        border: 1px solid var(--border);
        color: var(--accent-1);
        margin-bottom: var(--space-sm);
      }

      .feature-card h3 {
        margin: 0 0 var(--space-xs);
        font-size: 1.0625rem;
        font-weight: 700;
      }

      .feature-card p {
        margin: 0;
        font-size: 0.9375rem;
        color: var(--text-muted);
        line-height: 1.5;
      }

      .site-footer {
        margin-top: var(--space-xl);
        padding: var(--space-lg) 0 var(--space-2xl);
        border-top: 1px solid var(--border);
        text-align: center;
        color: var(--text-muted);
        font-size: 0.875rem;
      }

      .site-footer a {
        color: var(--text);
        text-decoration: underline;
        text-underline-offset: 2px;
      }

      .site-footer a:hover {
        color: var(--accent-1);
      }
    </style>

    <script>
      const form = document.getElementById('scan-form');
      const input = document.getElementById('url');
      const submitBtn = document.getElementById('submit-btn');
      const state = document.getElementById('state');
      const error = document.getElementById('error');
      const result = document.getElementById('result');
      const scoreValue = document.getElementById('score-value');
      const scoreLabel = document.getElementById('score-label');
      const resultUrl = document.getElementById('result-url');
      const breakdownEl = document.getElementById('breakdown');
      const reportLink = document.getElementById('report-link');
      const copyLink = document.getElementById('copy-link');

      function normalizeUrl(raw) {
        let value = raw.trim();
        if (!value) return '';
        if (!/^https?:\/\//i.test(value)) {
          value = 'https://' + value;
        }
        return value;
      }

      function isValidUrl(value) {
        try {
          new URL(normalizeUrl(value));
          return true;
        } catch {
          return false;
        }
      }

      function setLoading(loading) {
        submitBtn.disabled = loading;
        submitBtn.setAttribute('aria-busy', String(loading));
        state.style.display = loading ? 'block' : 'none';
        if (loading) {
          error.style.display = 'none';
          result.style.display = 'none';
        }
      }

      function showError(message) {
        error.textContent = message;
        error.style.display = 'block';
        state.style.display = 'none';
      }

      function stateClass(state) {
        if (state === 'ok') return 'state-ok';
        if (state === 'parcial') return 'state-parcial';
        return 'state-fallo';
      }

      function renderBreakdown(items) {
        breakdownEl.innerHTML = '';
        for (const item of items) {
          const pct = item.max ? Math.round((item.earned / item.max) * 100) : 0;
          const row = document.createElement('div');
          row.className = 'breakdown-item';
          row.innerHTML = `
            <div class="breakdown-header">
              <span class="breakdown-name">${item.name}</span>
              <span class="breakdown-score">${Math.round(item.earned)} / ${item.max}</span>
            </div>
            <div class="bar-track">
              <div class="bar-fill ${stateClass(item.state)}" data-width="${pct}"></div>
            </div>
          `;
          breakdownEl.appendChild(row);
        }
        requestAnimationFrame(() => {
          const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          breakdownEl.querySelectorAll('.bar-fill').forEach((bar, index) => {
            const width = bar.getAttribute('data-width');
            if (reduced) {
              bar.style.width = width + '%';
            } else {
              setTimeout(() => {
                bar.style.width = width + '%';
              }, 80 + index * 80);
            }
          });
        });
      }

      function showResult(data, snapshot) {
        scoreValue.textContent = String(data.score);
        scoreLabel.textContent = data.label;
        scoreLabel.className = 'result-label ' + stateClass(
          data.score >= 80 ? 'ok' : data.score >= 50 ? 'parcial' : 'fallo'
        );
        resultUrl.textContent = snapshot.url;
        reportLink.href = data.informe_url;
        renderBreakdown(snapshot.breakdown);
        result.style.display = 'block';
        state.style.display = 'none';
      }

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const raw = input.value;
        if (!isValidUrl(raw)) {
          showError('Ingresa una URL válida, por ejemplo https://tunegocio.com');
          return;
        }
        setLoading(true);
        try {
          const response = await fetch('/api/scan', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ url: normalizeUrl(raw) }),
          });
          const data = await response.json().catch(() => ({}));
          if (!response.ok) {
            throw new Error(data.error || 'El escaneo falló. Intenta de nuevo.');
          }

          const reportResponse = await fetch(`/api/informe/${data.id}`);
          const snapshot = await reportResponse.json().catch(() => ({}));
          if (!reportResponse.ok) {
            throw new Error(snapshot.error || 'No se pudo cargar el desglose del informe.');
          }

          showResult(data, snapshot);
        } catch (err) {
          showError(err.message || 'No pudimos escanear el sitio. Revisa la URL e intenta de nuevo.');
        } finally {
          setLoading(false);
        }
      });

      copyLink.addEventListener('click', async () => {
        const href = reportLink.href;
        try {
          await navigator.clipboard.writeText(href);
          const original = copyLink.textContent;
          copyLink.textContent = 'Enlace copiado';
          setTimeout(() => (copyLink.textContent = original), 2000);
        } catch {
          window.prompt('Copia este enlace:', href);
        }
      });
    </script>
  </body>
</html>
