---
import LandingPage from '../components/LandingPage.astro';

const cookie = Astro.cookies.get('lpb-locale')?.value;
const acceptLang = Astro.request.headers.get('accept-language') || '';

if (cookie === 'en' || (!cookie && acceptLang.toLowerCase().startsWith('en'))) {
  Astro.cookies.set('lpb-locale', 'en', {
    path: '/',
    sameSite: 'lax',
    maxAge: 60 * 60 * 24 * 365,
  });
  return Astro.redirect('/en/');
}
---

<LandingPage locale="es" />
