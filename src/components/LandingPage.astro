---
import '../styles/tokens.css';
import ThemeInit from './ThemeInit.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import { implementationTiers, monitoringPlans, pricingNote, formatPrice } from '../data/pricing.js';
import { getLocalizedPath, t, type Locale } from '../i18n/index.js';
import { getScanCountFromEnv } from '../lib/rate-limit.js';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const origin = Astro.url.origin;
const canonicalPath = getLocalizedPath('/', locale);
const canonical = `${origin}${canonicalPath}`;
const ogImage = `${origin}/og-image.png`;
const scanCount = await getScanCountFromEnv();
const title = t(locale, 'landing', 'metaTitle');
const description = t(locale, 'landing', 'metaDescription');
const ogLocale = t(locale, 'landing', 'ogLocale');
const eyebrow = t(locale, 'landing', 'eyebrow');
const h1 = t(locale, 'landing', 'h1');
const lead = t(locale, 'landing', 'lead');
const featureItems = t(locale, 'landing', 'featureItems');
const implementationPath = getLocalizedPath('/implementacion', locale);

const messages = {
  invalidUrlError: t(locale, 'landing', 'invalidUrlError'),
  genericError: t(locale, 'landing', 'genericError'),
  rateLimitedError: t(locale, 'landing', 'rateLimitedError'),
  scanningTitle: t(locale, 'landing', 'scanningTitle'),
  scanningItems: t(locale, 'landing', 'scanningItems'),
  resultScoreMax: t(locale, 'landing', 'resultScoreMax'),
  viewReport: t(locale, 'landing', 'viewReport'),
  copyLink: t(locale, 'landing', 'copyLink'),
  copiedLink: t(locale, 'landing', 'copiedLink'),
  breakdownLabel: t(locale, 'landing', 'breakdownLabel'),
  resultLabelSubtitles: {
    ok: t(locale, 'landing', 'resultLabelSubtitleOk'),
    parcial: t(locale, 'landing', 'resultLabelSubtitleParcial'),
    fallo: t(locale, 'landing', 'resultLabelSubtitleFallo'),
  },
  checkNames: Object.fromEntries(featureItems.map((c) => [c.id, c.name])),
  lang: locale,
};
---

<html lang={locale}>
  <head>
    <ThemeInit />
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href={`${origin}/`} />
    <link rel="alternate" hreflang="en" href={`${origin}/en/`} />
    <link rel="alternate" hreflang="x-default" href={`${origin}/`} />
    <title>{title}</title>
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    <Header locale={locale} />

    <main class="container">
      <section class="hero" aria-labelledby="hero-title">
        <p class="eyebrow">{eyebrow}</p>
        <h1 id="hero-title" class="hero-title">
          {h1.split('\n').map((line, i) => (
            <>
              {i > 0 && <br />}
              {line}
            </>
          ))}
        </h1>
        <p class="lead">{lead}</p>

        <div class="scan-card" id="scan-card">
          <form id="scan-form" class="scan-form" novalidate>
            <label class="sr-only" for="url">{t(locale, 'landing', 'formLabel')}</label>
            <div class="input-row">
              <input
                id="url"
                name="url"
                type="text"
                inputmode="url"
                autocomplete="url"
                placeholder={t(locale, 'landing', 'formPlaceholder')}
                required
              />
              <button type="submit" class="btn btn-primary" id="submit-btn">
                <span class="btn-text">{t(locale, 'landing', 'formSubmit')}</span>
                <span class="spinner" aria-hidden="true"></span>
              </button>
            </div>
          </form>

          <div id="state" class="state state-loading" style="display: none;">
            <div class="state-glow" aria-hidden="true"></div>
            <p><strong>{t(locale, 'landing', 'scanningTitle')}</strong></p>
            <ul>
              {t(locale, 'landing', 'scanningItems').map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>

          <div id="error" class="state state-error" style="display: none;"></div>

          <div id="result" class="result" style="display: none;">
            <div class="result-score">
              <span id="score-value">0</span><span class="result-max">{t(locale, 'landing', 'resultScoreMax')}</span>
            </div>
            <div class="result-label" id="score-label">Listo Pa Bots</div>
            <p class="result-subtitle" id="score-subtitle" style="display: none;"></p>
            <p class="result-url" id="result-url"></p>

            <div class="breakdown" id="breakdown" aria-label={t(locale, 'landing', 'breakdownLabel')}></div>

            <div class="actions">
              <a id="report-link" href="#" class="btn btn-primary">{t(locale, 'landing', 'viewReport')}</a>
              <button id="copy-link" class="btn btn-secondary" type="button">{t(locale, 'landing', 'copyLink')}</button>
            </div>
          </div>
        </div>
      </section>

      <section class="features" aria-labelledby="features-title">
        <h2 id="features-title" class="section-title">{t(locale, 'landing', 'featuresTitle')}</h2>
        <div class="features-grid">
          {
            featureItems.map((check) => (
              <article class="feature-card">
                <div class="feature-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                    {check.icon.map((d) => (
                      <path d={d} />
                    ))}
                  </svg>
                </div>
                <h3>{check.name}</h3>
                <p>{check.body}</p>
              </article>
            ))
          }
        </div>
      </section>

      <section class="pricing" aria-labelledby="pricing-title">
        <h2 id="pricing-title" class="section-title">{t(locale, 'landing', 'pricingTitle')}</h2>
        <p class="pricing-subtitle">{t(locale, 'landing', 'pricingSubtitle')}</p>

        <div class="pricing-grid">
          {
            implementationTiers.map((tier) => (
              <article class="pricing-card">
                <h3>{tier.name[locale]}</h3>
                <p class="pricing-price">{formatPrice(tier.price, locale)}</p>
                <p class="pricing-description">{tier.description[locale]}</p>
                <p class="pricing-includes">{tier.includes[locale]}</p>
                <ul>
                  {tier.features.map((item) => (
                    <li>{item[locale]}</li>
                  ))}
                </ul>
                <a href={implementationPath} class="btn btn-primary">
                  {t(locale, 'landing', 'pricingCta')}
                </a>
              </article>
            ))
          }
        </div>

        <div class="monitoring">
          <h3>{t(locale, 'landing', 'pricingMonitoringTitle')}</h3>
          <div class="monitoring-grid">
            {
              monitoringPlans.map((plan) => (
                <article class="pricing-card monitoring-card">
                  <h4>{plan.name[locale]}</h4>
                  <p class="pricing-price">{formatPrice(plan.price, locale)}</p>
                  <p class="pricing-description">{plan.description[locale]}</p>
                  <ul>
                    {plan.features.map((item) => (
                      <li>{item[locale]}</li>
                    ))}
                  </ul>
                  <a href={implementationPath} class="btn btn-secondary">
                    {t(locale, 'landing', 'pricingCta')}
                  </a>
                </article>
              ))
            }
          </div>
        </div>

        <p class="pricing-note">
          <span class="pricing-note-dot" aria-hidden="true" />
          {pricingNote[locale]}
        </p>

        <div class="pricing-cta">
          <a href={implementationPath} class="btn btn-primary">
            {t(locale, 'landing', 'pricingCta')}
          </a>
        </div>
      </section>

      <Footer locale={locale} currentPath={canonicalPath} scanCount={scanCount} />
    </main>

    <style is:global>
      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
      }

      .container {
        width: 100%;
        max-width: 760px;
        margin: 0 auto;
      }

      .site-header {
        padding: var(--space-md) 0;
      }

      .header-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-md);
      }

      .header-controls {
        display: flex;
        align-items: center;
        gap: var(--space-sm);
      }

      .hero {
        padding: var(--space-xl) 0 var(--space-2xl);
        text-align: center;
      }

      .eyebrow {
        display: inline-block;
        margin: 0 0 var(--space-sm);
        font-size: 0.8125rem;
        font-weight: 700;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--accent-secondary);
        text-shadow: 0 0 24px var(--accent-secondary-glow);
      }

      .hero-title {
        font-size: clamp(2.5rem, 10vw, 4.25rem);
        font-weight: 800;
        line-height: 1.05;
        letter-spacing: -0.03em;
        margin: 0 0 var(--space-md);
        text-wrap: balance;
      }

      .hero-title::after {
        content: '';
        display: block;
        width: 80px;
        height: 4px;
        margin: var(--space-md) auto 0;
        border-radius: var(--radius-pill);
        background: var(--accent-gradient);
        box-shadow: 0 0 24px var(--accent-glow);
      }

      .lead {
        font-size: clamp(1.125rem, 4vw, 1.375rem);
        font-weight: 300;
        line-height: 1.55;
        color: var(--text-muted);
        margin: 0 auto var(--space-xl);
        max-width: 560px;
      }

      .scan-card {
        background: var(--bg-elevated);
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        padding: var(--space-md);
        box-shadow: var(--shadow);
      }

      @media (min-width: 640px) {
        .scan-card {
          padding: var(--space-lg);
        }
      }

      .scan-form {
        width: 100%;
      }

      .input-row {
        display: flex;
        flex-direction: column;
        gap: var(--space-sm);
      }

      @media (min-width: 520px) {
        .input-row {
          flex-direction: row;
          align-items: stretch;
        }
      }

      .input-row input {
        flex: 1 1 auto;
        min-width: 0;
        font-size: 1rem;
        padding: var(--space-sm) var(--space-md);
        border: 1px solid var(--border);
        border-radius: var(--radius-pill);
        background: var(--bg);
        color: var(--text);
        outline: none;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
        min-height: 3rem;
      }

      .input-row input::placeholder {
        color: var(--text-muted);
        opacity: 1;
      }

      .input-row input:focus {
        border-color: var(--accent-1);
        box-shadow: 0 0 0 3px var(--accent-glow);
      }

      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: var(--space-xs);
        font-size: 1rem;
        font-weight: 700;
        padding: var(--space-sm) var(--space-md);
        border-radius: var(--radius-pill);
        border: 1px solid transparent;
        min-height: 3rem;
        text-decoration: none;
        cursor: pointer;
        transition: transform 0.15s ease, box-shadow 0.2s ease, border-color 0.2s ease;
      }

      .btn:hover:not(:disabled) {
        transform: translateY(-1px);
      }

      .btn-primary {
        background: var(--accent-gradient);
        color: #fff;
        border-color: transparent;
        box-shadow: 0 8px 28px var(--accent-glow);
      }

      .btn-primary:hover:not(:disabled) {
        box-shadow: 0 12px 36px var(--accent-glow), 0 0 0 1px rgba(255, 255, 255, 0.1) inset;
      }

      .btn-secondary {
        background: transparent;
        color: var(--text);
        border-color: var(--border);
      }

      .btn-secondary:hover:not(:disabled) {
        border-color: var(--accent-1);
        color: var(--accent-1);
      }

      .btn:disabled {
        opacity: 0.8;
        cursor: wait;
      }

      .btn .spinner {
        display: none;
      }

      .btn[aria-busy='true'] .btn-text {
        display: none;
      }

      .btn[aria-busy='true'] .spinner {
        display: inline-block;
      }

      .spinner {
        width: 1.25rem;
        height: 1.25rem;
        border: 3px solid rgba(255, 255, 255, 0.35);
        border-top-color: #ffffff;
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
      }

      @keyframes spin {
        to {
          transform: rotate(360deg);
        }
      }

      .state {
        margin-top: var(--space-md);
        padding: var(--space-md);
        border-radius: var(--radius-md);
        font-size: 0.9375rem;
      }

      .state p {
        margin: 0 0 var(--space-xs);
      }

      .state ul {
        margin: 0;
        padding-left: 1.25rem;
      }

      .state li {
        margin-bottom: 0.35rem;
      }

      .state-loading {
        position: relative;
        overflow: hidden;
        background: var(--bg);
        border: 1px solid var(--border);
        color: var(--text-muted);
      }

      .state-loading strong {
        color: var(--text);
      }

      .state-glow {
        position: absolute;
        inset: 0;
        pointer-events: none;
        background: radial-gradient(circle at 50% 50%, var(--accent-glow), transparent 70%);
        animation: pulse-glow 2s ease-in-out infinite;
      }

      @keyframes pulse-glow {
        0%, 100% {
          opacity: 0.5;
          transform: scale(0.96);
        }
        50% {
          opacity: 1;
          transform: scale(1.04);
        }
      }

      .state-error {
        background: var(--state-fallo-bg);
        border: 1px solid var(--state-fallo);
        color: var(--state-fallo);
      }

      .result {
        margin-top: var(--space-lg);
        text-align: center;
      }

      .result-score {
        font-size: clamp(3.5rem, 14vw, 5.5rem);
        font-weight: 800;
        line-height: 1;
        letter-spacing: -0.04em;
      }

      .result-max {
        font-size: 1.5rem;
        font-weight: 600;
        color: var(--text-muted);
        margin-left: 0.1em;
      }

      .result-label {
        display: inline-block;
        margin-top: var(--space-sm);
        padding: var(--space-xs) var(--space-md);
        border-radius: var(--radius-pill);
        font-size: 1.125rem;
        font-weight: 700;
      }

      .result-label.state-ok {
        background: var(--state-ok-bg);
        color: var(--state-ok);
      }

      .result-label.state-parcial {
        background: var(--state-parcial-bg);
        color: var(--state-parcial);
      }

      .result-label.state-fallo {
        background: var(--state-fallo-bg);
        color: var(--state-fallo);
      }

      .result-subtitle {
        margin: var(--space-xs) 0 0;
        color: var(--text-muted);
        font-size: 0.9375rem;
      }

      .result-url {
        margin: var(--space-sm) 0 0;
        color: var(--text-muted);
        font-size: 0.9375rem;
        word-break: break-all;
      }

      .breakdown {
        margin-top: var(--space-lg);
        display: grid;
        gap: var(--space-md);
      }

      .breakdown-item {
        text-align: left;
      }

      .breakdown-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-sm);
        margin-bottom: var(--space-xs);
        font-size: 0.9375rem;
      }

      .breakdown-name {
        font-weight: 600;
      }

      .breakdown-score {
        font-weight: 700;
        color: var(--text-muted);
        white-space: nowrap;
      }

      .bar-track {
        height: 8px;
        border-radius: var(--radius-pill);
        background: var(--bar-track-bg);
        border: 1px solid var(--border);
        overflow: hidden;
      }

      .bar-fill {
        height: 100%;
        border-radius: var(--radius-pill);
        width: 0;
        transition: width 0.8s cubic-bezier(0.22, 1, 0.36, 1);
      }

      .bar-fill.state-ok {
        background: var(--state-ok);
        box-shadow: 0 0 12px rgba(52, 211, 153, 0.35);
      }

      .bar-fill.state-parcial {
        background: var(--state-parcial);
        box-shadow: 0 0 12px rgba(245, 166, 35, 0.35);
      }

      .bar-fill.state-fallo {
        background: var(--state-fallo);
        box-shadow: 0 0 12px rgba(248, 113, 113, 0.35);
      }

      .actions {
        margin-top: var(--space-lg);
        display: flex;
        flex-direction: column;
        gap: var(--space-sm);
      }

      @media (min-width: 520px) {
        .actions {
          flex-direction: row;
          justify-content: center;
        }
      }

      .features {
        padding-bottom: var(--space-2xl);
      }

      .section-title {
        text-align: center;
        font-size: 1.75rem;
        font-weight: 700;
        margin: 0 0 var(--space-lg);
      }

      .features-grid {
        display: grid;
        gap: var(--space-md);
      }

      @media (min-width: 560px) {
        .features-grid {
          grid-template-columns: repeat(2, 1fr);
        }
      }

      .feature-card {
        background: var(--bg-elevated);
        border: 1px solid var(--border);
        border-radius: var(--radius-md);
        padding: var(--space-md);
        transition: transform 0.2s ease, border-color 0.2s ease;
      }

      .feature-card:hover {
        transform: translateY(-2px);
        border-color: var(--accent-1);
      }

      .feature-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2.75rem;
        height: 2.75rem;
        border-radius: var(--radius-pill);
        background: var(--bg);
        border: 1px solid var(--border);
        color: var(--accent-1);
        margin-bottom: var(--space-sm);
      }

      .feature-card h3 {
        margin: 0 0 var(--space-xs);
        font-size: 1.0625rem;
        font-weight: 700;
      }

      .feature-card p {
        margin: 0;
        font-size: 0.9375rem;
        color: var(--text-muted);
        line-height: 1.5;
      }

      .pricing {
        padding-bottom: var(--space-2xl);
      }

      .pricing-subtitle {
        text-align: center;
        color: var(--text-muted);
        margin: calc(var(--space-sm) * -1) 0 var(--space-lg);
      }

      .pricing-grid {
        display: grid;
        gap: var(--space-md);
        margin-bottom: var(--space-lg);
      }

      @media (min-width: 720px) {
        .pricing-grid {
          grid-template-columns: repeat(3, 1fr);
        }
      }

      .monitoring-grid {
        display: grid;
        gap: var(--space-md);
      }

      @media (min-width: 560px) {
        .monitoring-grid {
          grid-template-columns: repeat(2, 1fr);
        }
      }

      .pricing-card {
        background: var(--bg-elevated);
        border: 1px solid var(--border);
        border-radius: var(--radius-md);
        padding: var(--space-md);
        display: flex;
        flex-direction: column;
      }

      .pricing-card h3,
      .pricing-card h4 {
        margin: 0 0 var(--space-xs);
        font-size: 1.125rem;
        font-weight: 800;
      }

      .pricing-price {
        margin: 0 0 var(--space-sm);
        font-size: 1.0625rem;
        font-weight: 700;
        color: var(--accent-1);
      }

      .pricing-description {
        margin: 0 0 var(--space-sm);
        font-size: 0.9375rem;
        color: var(--text-muted);
        line-height: 1.5;
      }

      .pricing-includes {
        margin: 0 0 var(--space-xs);
        font-size: 0.8125rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--text);
      }

      .pricing-card ul {
        margin: 0 0 var(--space-md);
        padding-left: 1.25rem;
        font-size: 0.9375rem;
        color: var(--text-muted);
        line-height: 1.55;
        flex: 1 1 auto;
      }

      .pricing-card li {
        margin-bottom: 0.35rem;
      }

      .pricing-card .btn {
        width: 100%;
      }

      .monitoring {
        background: var(--bg-elevated);
        border: 1px solid var(--border);
        border-radius: var(--radius-md);
        padding: var(--space-md);
        margin-bottom: var(--space-md);
      }

      .monitoring > h3 {
        text-align: center;
        margin: 0 0 var(--space-md);
        font-size: 1.25rem;
        font-weight: 700;
      }

      .monitoring-card {
        border: 1px solid var(--border);
      }

      .pricing-note {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: var(--space-xs);
        text-align: center;
        color: var(--text-muted);
        font-size: 0.9375rem;
        margin-bottom: var(--space-md);
      }

      .pricing-note-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--accent-secondary);
      }

      .pricing-cta {
        text-align: center;
      }

    </style>

    <script define:vars={{ messages }}>
      const form = document.getElementById('scan-form');
      const input = document.getElementById('url');
      const submitBtn = document.getElementById('submit-btn');
      const state = document.getElementById('state');
      const error = document.getElementById('error');
      const result = document.getElementById('result');
      const scoreValue = document.getElementById('score-value');
      const scoreLabel = document.getElementById('score-label');
      const scoreSubtitle = document.getElementById('score-subtitle');
      const resultUrl = document.getElementById('result-url');
      const breakdownEl = document.getElementById('breakdown');
      const reportLink = document.getElementById('report-link');
      const copyLink = document.getElementById('copy-link');

      function normalizeUrl(raw) {
        let value = raw.trim();
        if (!value) return '';
        if (!/^https?:\/\//i.test(value)) {
          value = 'https://' + value;
        }
        return value;
      }

      function isValidUrl(value) {
        try {
          new URL(normalizeUrl(value));
          return true;
        } catch {
          return false;
        }
      }

      function setLoading(loading) {
        submitBtn.disabled = loading;
        submitBtn.setAttribute('aria-busy', String(loading));
        state.style.display = loading ? 'block' : 'none';
        if (loading) {
          error.style.display = 'none';
          result.style.display = 'none';
        }
      }

      function showError(message) {
        error.textContent = message;
        error.style.display = 'block';
        state.style.display = 'none';
      }

      function stateClass(state) {
        if (state === 'ok') return 'state-ok';
        if (state === 'parcial') return 'state-parcial';
        return 'state-fallo';
      }

      function scoreState(score) {
        if (score >= 80) return 'ok';
        if (score >= 50) return 'parcial';
        return 'fallo';
      }

      function renderBreakdown(items) {
        breakdownEl.innerHTML = '';
        for (const item of items) {
          const pct = item.max ? Math.round((item.earned / item.max) * 100) : 0;
          const name = messages.checkNames[item.id] || item.name;
          const row = document.createElement('div');
          row.className = 'breakdown-item';
          row.innerHTML = `
            <div class="breakdown-header">
              <span class="breakdown-name">${name}</span>
              <span class="breakdown-score">${Math.round(item.earned)} / ${item.max}</span>
            </div>
            <div class="bar-track">
              <div class="bar-fill ${stateClass(item.state)}" data-width="${pct}"></div>
            </div>
          `;
          breakdownEl.appendChild(row);
        }
        requestAnimationFrame(() => {
          const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          breakdownEl.querySelectorAll('.bar-fill').forEach((bar, index) => {
            const width = bar.getAttribute('data-width');
            if (reduced) {
              bar.style.width = width + '%';
            } else {
              setTimeout(() => {
                bar.style.width = width + '%';
              }, 80 + index * 80);
            }
          });
        });
      }

      function showResult(data, snapshot) {
        const sState = scoreState(data.score);
        scoreValue.textContent = String(data.score);
        scoreLabel.textContent = data.label;
        scoreLabel.className = 'result-label ' + stateClass(sState);
        scoreSubtitle.textContent = messages.resultLabelSubtitles[sState] || '';
        scoreSubtitle.style.display = 'block';
        resultUrl.textContent = snapshot.url;
        reportLink.href = data.informe_url;
        renderBreakdown(snapshot.breakdown);
        result.style.display = 'block';
        state.style.display = 'none';
      }

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const raw = input.value;
        if (!isValidUrl(raw)) {
          showError(messages.invalidUrlError);
          return;
        }
        setLoading(true);
        try {
          const response = await fetch('/api/scan', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ url: normalizeUrl(raw), lang: messages.lang }),
          });
          const data = await response.json().catch(() => ({}));
          if (!response.ok) {
            if (response.status === 429 && data.error === 'rate_limited') {
              throw new Error(messages.rateLimitedError);
            }
            throw new Error(data.error || messages.genericError);
          }

          const reportResponse = await fetch(`/api/informe/${data.id}`);
          const snapshot = await reportResponse.json().catch(() => ({}));
          if (!reportResponse.ok) {
            throw new Error(snapshot.error || messages.genericError);
          }

          showResult(data, snapshot);
        } catch (err) {
          showError(err.message || messages.genericError);
        } finally {
          setLoading(false);
        }
      });

      copyLink.addEventListener('click', async () => {
        const href = reportLink.href;
        try {
          await navigator.clipboard.writeText(href);
          const original = copyLink.textContent;
          copyLink.textContent = messages.copiedLink;
          setTimeout(() => (copyLink.textContent = original), 2000);
        } catch {
          window.prompt(messages.copyLink + ':', href);
        }
      });
    </script>
  </body>
</html>
